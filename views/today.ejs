<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>全クラスの時間割 | 時間割共有</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="container">
    <header class="topbar">
      <h1>全クラスの時間割</h1>
      <div>
        <span><%= user.username %>さん(<%= user.role %>)</span>
        <a href="/">クラス一覧</a>
        <% if (user.role === 'admin') { %>
          <a href="/admin/base">基本パターン設定</a>
          <a href="/admin/weeks">週タイプ設定</a>
          <a href="/admin/day-overrides">曜日振替設定</a>
          <a href="/admin/users">ユーザー管理</a>
        <% } %>
        <form method="POST" action="/logout" style="display:inline">
          <button type="submit">ログアウト</button>
        </form>
      </div>
    </header>

    <form method="GET" action="/today" class="date-form">
      <label>日付
        <input type="date" name="date" value="<%= date %>">
      </label>
      <button type="submit">表示</button>
    </form>

    <h2>
      <%= date %>(<%= actualLabel %>)
    </h2>

    <% if (!effectiveDay) { %>
      <p>この日は授業がありません。</p>
    <% } else { %>
      <% if (effectiveLabel && actualLabel && effectiveLabel !== actualLabel) { %>
        <p class="warning"><%= effectiveLabel %>の時間割で実施する日として設定されています。</p>
      <% } %>
      <form method="POST" action="/today">
        <input type="hidden" name="date" value="<%= date %>">
        <table class="timetable">
          <thead>
            <tr>
              <th>クラス</th>
              <% periods.forEach(period => { %><th><%= period %>限</th><% }) %>
            </tr>
          </thead>
          <tbody>
            <% classes.forEach(c => {
                 const schedule = scheduleByClass[c.id];
            %>
              <tr>
                <th>
                  <%= c.name %>
                  <% if (!schedule.weekType) { %><br><span class="warning-small">週未設定</span><% } %>
                </th>
                <% periods.forEach(period => {
                     const entry = schedule.entries[period];
                     const value = entry ? entry.subject : '';
                     const changed = entry && entry.changed;
                %>
                  <td class="<%= changed ? 'changed-row' : '' %>">
                    <% if (canEdit) { %>
                      <input type="text" name="subject_<%= c.id %>_<%= period %>" value="<%= value %>" placeholder="-">
                    <% } else { %>
                      <%= value || '-' %>
                    <% } %>
                  </td>
                <% }) %>
              </tr>
            <% }) %>
          </tbody>
        </table>
        <% if (canEdit) { %>
          <button type="submit">この日の変更を保存</button>
        <% } %>
      </form>
    <% } %>
  </div>
</body>
</html>
